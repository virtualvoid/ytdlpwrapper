<Window x:Class="YtMp3Downloader.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="O aplikácii" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="White" FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Image Source="Assets/logo.png" Width="72" Height="72" VerticalAlignment="Top" Margin="0,0,18,0" />

        <StackPanel Grid.Column="1">
            <TextBlock Text="YtMp3 Downloader" FontSize="22" FontWeight="SemiBold" />
            <TextBlock x:Name="VersionText" Foreground="#6B7280" Margin="0,2,0,12" />
            <TextBlock Text="Sťahovanie playlistov a videí z YouTube do MP3." TextWrapping="Wrap" />

            <TextBlock Text="Autor" FontWeight="SemiBold" Margin="0,16,0,2" />
            <TextBlock Text="Juraj Suchán" />
            <TextBlock>
                <Hyperlink NavigateUri="mailto:juraj.suchan@gmail.com" RequestNavigate="OnNavigate">juraj.suchan@gmail.com</Hyperlink>
            </TextBlock>
            <TextBlock x:Name="CopyrightText" Foreground="#6B7280" Margin="0,8,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Margin="0,20,0,0"
                Padding="0,12,0,0">
            <StackPanel>
                <TextBlock Text="Použité nástroje" FontWeight="SemiBold" />
                <TextBlock Foreground="#6B7280" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="yt-dlp (Unlicense), FFmpeg (LGPL) a Deno (MIT). Sťahujú sa pri prvom spustení a patria ich autorom." />
            </StackPanel>
        </Border>

        <Button Grid.Row="2" Grid.ColumnSpan="2" Content="OK" IsDefault="True" IsCancel="True"
                HorizontalAlignment="Right" Margin="0,18,0,0" MinWidth="80" />
    </Grid>
</Window>
