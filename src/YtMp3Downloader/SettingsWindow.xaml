<Window x:Class="YtMp3Downloader.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nastavenia" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#F4F5F7" FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="18">
        <TextBlock Text="Výstupný priečinok" FontWeight="SemiBold" />
        <Grid Margin="0,4,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
            <Button Grid.Column="1" Content="Prehľadávať…" Margin="0" Command="{Binding BrowseOutputCommand}" />
        </Grid>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="Kvalita MP3" FontWeight="SemiBold" />
                <ComboBox Margin="0,4,0,0" ItemsSource="{Binding Qualities}" DisplayMemberPath="Label"
                          SelectedValuePath="Value" SelectedValue="{Binding AudioQuality}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <TextBlock Text="Max. počet položiek z playlistu" FontWeight="SemiBold" />
                <TextBox Margin="0,4,0,0" Text="{Binding MaxItems, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </Grid>

        <TextBlock Text="Cookies (pre vekovo obmedzené alebo súkromné videá)" FontWeight="SemiBold" />
        <RadioButton Content="Nepoužívať" IsChecked="{Binding CookiesNone}" GroupName="c" Margin="0,6,0,0" />
        <RadioButton Content="Zo súboru cookies.txt" IsChecked="{Binding CookiesFile}" GroupName="c" Margin="0,4,0,0" />
        <Grid Margin="22,4,0,0" IsEnabled="{Binding CookiesFile}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding CookieFilePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
            <Button Grid.Column="1" Content="Vybrať…" Margin="0" Command="{Binding BrowseCookiesCommand}" />
        </Grid>
        <RadioButton Content="Z prehliadača" IsChecked="{Binding CookiesBrowser}" GroupName="c" Margin="0,6,0,0" />
        <ComboBox Margin="22,4,0,0" Width="160" HorizontalAlignment="Left" IsEnabled="{Binding CookiesBrowser}"
                  ItemsSource="{Binding Browsers}" SelectedItem="{Binding CookieBrowserName}" />

        <TextBlock Text="Nástroje" FontWeight="SemiBold" Margin="0,16,0,0" />
        <TextBlock Text="{Binding ToolsInfo}" Margin="0,4,0,6" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" />
        <Button Content="Aktualizovať yt-dlp" HorizontalAlignment="Left" Command="{Binding UpdateYtDlpCommand}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Uložiť" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnOk" />
            <Button Content="Zrušiť" IsCancel="True" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
